# Production deployment (Supabase hosted + GitHub Pages):
#   VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Local development with aspire.love:
#   `aspire start` injects these values automatically - no .env file needed.
#   The local Kong gateway only accepts the JWT Aspire generates (NOT the
#   literal `local-dev-anon-key` in aspire/infra/supabase/config/kong.yml,
#   which Aspire replaces at startup). If you need to run `npm run dev` outside Aspire, read the current injected values with:
#     docker inspect runxctiming-supabase-kong --format "{{range .Config.Env}}{{println .}}{{end}}" | Select-String SUPABASE_ANON_KEY

VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=<PASTE the JWT printed by the docker inspect command above>
